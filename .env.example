# 复制为 .env 后修改。生产环境必须更换下面两个密钥。
# JWT 签名密钥（≥32 字符随机串）
CS_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# API Key 加密主密钥（Fernet）。生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CS_MASTER_KEY=
# 是否开放注册（第一个注册用户自动成为管理员）
CS_ALLOW_REGISTRATION=true

# 云端浏览器
CS_BROWSER_HEADLESS=true
# 如需经代理出网：CS_BROWSER_PROXY=http://proxy:3128
CS_BROWSER_MAX_CONTEXTS=4
# 浏览器搜索引擎顺序（被拦截会自动冷却并切换）
CS_SEARCH_ENGINES=["bing","baidu","sogou"]
CS_SEARCH_ENGINE_COOLDOWN_S=600

# 任务执行
CS_TASK_READ_CONCURRENCY=3
CS_WORKER_MAX_TASKS=2
